# Configure these with Firebase Functions secrets, not plaintext production files:
# firebase functions:secrets:set SUPABASE_URL
# firebase functions:secrets:set SUPABASE_SERVICE_ROLE_KEY
# App Check is enforced on sensitive callable functions in production.

# Development: false while using 127.0.0.1 without a configured App Check site key.
# Production: set true after configuring Firebase App Check / reCAPTCHA Enterprise.
USC_ENFORCE_APP_CHECK=false
